# Local development only. Choose your own password before starting Compose.
POSTGRES_USER=todo_dev
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=todo_dev
# The backend reads these variables; Compose supplies DB_HOST=db.
DB_HOST=127.0.0.1
DB_PORT=5432
# Used only by the Vite server, never exposed through a VITE_* browser variable.
API_PROXY_TARGET=http://127.0.0.1:8000
